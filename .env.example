# ---------------------------------------------------------------------------
# Tool-Calling Data Analysis Agent - example configuration
# Copy to ".env" and edit.  NEVER commit a filled-in .env.
# Every value below can also be supplied as a plain environment variable.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
ENVIRONMENT=local                       # local | docker | production | test
LOG_LEVEL=INFO
DEFAULT_PROVIDER=free                   # free | openai | anthropic | openrouter | custom | ollama
SEED_DEMO_DATA_ON_STARTUP=true          # seed the synthetic demo datasets on first start

# --- storage ---------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts
DEMO_DIR=./data/demo
EXPORT_DIR=./data/exports
# SQLite by default.  Point this at PostgreSQL for a multi-user deployment:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/tda

# --- limits ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS_INGESTED=1000000
MAX_TOOL_ROUNDS=8
MAX_TOOL_RESULT_ROWS=2000
MAX_TOOL_RESULT_BYTES=512000
TOOL_TIMEOUT_SECONDS=30
REQUEST_TOKEN_BUDGET=120000
REQUEST_COST_BUDGET_USD=0.50

# --- security --------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
ALLOW_CREDENTIALED_CORS=false
# Used to derive the encryption key for stored provider API keys.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- providers -------------------------------------------------------------
# An OpenAI *platform* API key is required.  A ChatGPT Plus/Pro subscription
# does not include API access.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# An Anthropic console API key is required (a claude.ai subscription is not enough).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Any OpenAI-compatible endpoint (vLLM, LM Studio, LiteLLM, a corporate gateway, ...).
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# A local Ollama server.  No key is required and no data leaves your machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
